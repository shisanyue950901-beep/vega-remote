{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vega 控制台",
  "version": "0.5.0",
  "identifier": "com.vega.remote.console",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vega 控制台",
        "width": 960,
        "height": 640,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Vega 远程协助控制台",
    "longDescription": "零登录、零广告的远程协助与串流控制台。",
    "resources": {
      "resources/vega-defaults.json": "resources/vega-defaults.json",
      "resources/vega-pwhelper.ps1": "resources/vega-pwhelper.ps1",
      "../../host/install-rustdesk.ps1": "resources/host/install-rustdesk.ps1",
      "../../host/resolve-interactive-user.ps1": "resources/host/resolve-interactive-user.ps1",
      "../../host/lib/Vega.Common.psm1": "resources/host/lib/Vega.Common.psm1"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
