{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vega 控制台",
  "version": "0.5.0",
  "identifier": "com.vega.remote.console",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vega 控制台",
        "width": 960,
        "height": 640,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Vega 远程协助控制台",
    "longDescription": "零登录、零广告的远程协助与串流控制台。"
  }
}
