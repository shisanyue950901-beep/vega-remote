{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "控制台最小权限：窗口控制 + RustDesk/串流/诊断命令（build.rs AppManifest 声明），不开放文件系统、Shell、网络与托盘插件。",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-check-update",
    "allow-install-update",
    "allow-set-close-to-tray",
    "allow-get-device-id",
    "allow-get-server-config",
    "allow-get-relay-defaults",
    "allow-get-mobile-config-qr",
    "allow-connect-peer",
    "allow-get-recent-peers",
    "allow-open-rustdesk-window",
    "allow-open-rustdesk-download-page",
    "allow-get-rustdesk-status",
    "allow-test-server-connection",
    "allow-get-streaming-status",
    "allow-open-sunshine-pairing",
    "allow-open-sunshine-settings",
    "allow-start-moonlight-stream",
    "allow-run-doctor",
    "allow-export-doctor-log",
    "allow-get-peer-aliases",
    "allow-set-peer-alias",
    "allow-remove-peer",
    "allow-get-password-status",
    "allow-set-permanent-password",
    "allow-clear-permanent-password"
  ]
}
